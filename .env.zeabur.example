APP_ENV=production
LLM_PROVIDER=deepseek
# ── 可选 LLM Provider（取消注释并填入 Key 即可切换） ──────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3
# LLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=your_dashscope_api_key
# DASHSCOPE_MODEL=qwen-plus
# LLM_PROVIDER=zhipuai
# ZHIPUAI_API_KEY=your_zhipuai_api_key
# ZHIPUAI_MODEL=glm-4-flash
# LLM_PROVIDER=aihubmix
# AIHUBMIX_API_KEY=your_aihubmix_api_key
# AIHUBMIX_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
SEARCH_PROVIDER=multi
SEARCH_PROVIDERS=tavily,brave
SEARCH_MAX_WORKERS=4
TAVILY_API_KEY=your_tavily_api_key
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
BRAVE_SEARCH_FRESHNESS=
BRAVE_SEARCH_COUNTRY=US
BRAVE_SEARCH_LANG=en
BLOCKBEATS_API_KEY=your_blockbeats_api_key
BLOCKBEATS_LANG=cn
SERPAPI_API_KEY=
SERPAPI_ENGINE=google
SERPAPI_HL=zh-cn
SERPAPI_GL=cn
BOCHA_API_KEY=
BOCHA_FRESHNESS=oneWeek
SEARXNG_BASE_URL=
SEARXNG_LANGUAGE=auto
SEARXNG_TIME_RANGE=
SEARXNG_SAFESEARCH=0
X_MCP_SEARCH_URL=
X_MCP_API_KEY=
RAG_EMBEDDING_PROVIDER=hash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_FETCH_FULL_TEXT=false
RAG_FETCH_TIMEOUT_SECONDS=6
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
ENABLE_DEBUG_ROUTES=false
CORS_ALLOW_ORIGIN_REGEX=https://(www\.)?deepalpha\.best
DEEPALPHA_ACCESS_CODE=change-this-access-code
DEEPALPHA_DB_PATH=/data/deepalpha.sqlite3
CHROMA_DB_PATH=/data/chroma
SYMBOL_CACHE_TTL_SECONDS=86400
MARKET_CACHE_TTL_SECONDS=300
MARKET_REVIEW_CACHE_TTL_SECONDS=300
PROVIDER_HEALTH_CACHE_TTL_SECONDS=300
MARKET_DATA_PROVIDER_ORDER_CN=akshare,efinance,baostock,yahoo
MARKET_DATA_PROVIDER_ORDER_HK=akshare_hk_index,yahoo,akshare
MARKET_DATA_PROVIDER_ORDER_US=yfinance,yahoo,nasdaq,finnhub
MARKET_DATA_TIMEOUT_SECONDS=10
YAHOO_FINANCE_HOSTS=query1.finance.yahoo.com,query2.finance.yahoo.com
FINNHUB_API_KEY=your_finnhub_api_key
FINANCIALS_CACHE_TTL_SECONDS=21600
SYMBOL_LOOKUP_RATE_LIMIT=60
MARKET_CHART_RATE_LIMIT=120
FINANCIALS_RATE_LIMIT=60
SEC_USER_AGENT=DeepAlpha production contact@example.com
REPORT_USER_DAILY_LIMIT=3
REPORT_CREATE_RATE_LIMIT_PER_HOUR=5
REPORT_CREATE_RATE_LIMIT_PER_DAY=10
REPORT_GLOBAL_DAILY_LIMIT=50
